{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-private-pr",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bcac22f7-fe11-43bc-a36b-82bff6e36a96","database_name": "my-private-pr" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3e53c99ae56c46b2b0fe2bb58e910f39" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
